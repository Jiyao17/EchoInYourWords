# HPG/Slurm wrappers for EchoInYourWords.
#
# This file intentionally does not modify the project's main Makefile.
# It only submits Slurm jobs that activate an environment and then call the
# repository's existing make/python entrypoints with Qwen excluded by default.

ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
SLURM_DIR := $(ROOT)/scripts/slurm

ENV_SCRIPT ?= $(SLURM_DIR)/hpg_env.sh
PARTITION ?= hpg-b200
ACCOUNT ?=
TIME ?= 4-00:00:00
GRES ?= gpu:b200:1
CPUS ?= 16
MEM ?= 128G

DATASET ?=
METHOD ?=
EXP_STAGE ?= smoke
PAIR_SCOPE ?= all
CONCURRENCY_PER_GPU ?= 1
RESUME ?= 0
DRY_RUN ?= 0
DATASETS ?=

SAFE_MODELS := unsloth/gemma-3-1b-it unsloth/Llama-3.2-3B-Instruct mistralai/Ministral-8B-Instruct-2410

.DEFAULT_GOAL := help

.PHONY: help
help:
	@echo "HPG wrappers for EchoInYourWords (Qwen skipped by default)."
	@echo ""
	@echo "Targets:"
	@echo "  make -f Makefile.hpg submit-prepare"
	@echo "  make -f Makefile.hpg submit-method METHOD=lcfx DATASET=hotpotqa_bridge"
	@echo "  make -f Makefile.hpg submit-exp METHOD=t2t DATASET=ropes"
	@echo "  make -f Makefile.hpg submit-sweep"
	@echo ""
	@echo "Common knobs:"
	@echo "  ENV_SCRIPT=$(ENV_SCRIPT)"
	@echo "  PARTITION=$(PARTITION) GRES=$(GRES) CPUS=$(CPUS) MEM=$(MEM) TIME=$(TIME)"
	@echo "  SAFE_MODELS=$(SAFE_MODELS)"
	@echo "  PAIR_SCOPE=$(PAIR_SCOPE)    # all + safe filters => non-Qwen Gemma/Llama/Mistral 3x3"
	@echo "  DATASET=<dataset>           # for submit-method / submit-exp"
	@echo "  METHOD=<lcfx|xkv|t2t>       # for submit-method / submit-exp / submit-sweep"
	@echo "  EXP_STAGE=<smoke|full>      # for submit-exp / submit-sweep"
	@echo "  RESUME=1                    # continue from results/sweep_manifest.jsonl"
	@echo "  DRY_RUN=1                   # preview resolved cells inside Slurm"
	@echo ""
	@echo "Before first use, copy scripts/slurm/hpg_env.sh.example -> scripts/slurm/hpg_env.sh"
	@echo "and edit it to source your HPG Python environment."

.PHONY: check-env
check-env:
	@test -f "$(ENV_SCRIPT)" || (echo "Missing $(ENV_SCRIPT). Copy hpg_env.sh.example first." && exit 1)

.PHONY: submit-prepare
submit-prepare: check-env
	sbatch $(if $(ACCOUNT),--account=$(ACCOUNT),) --partition=$(PARTITION) --gres=$(GRES) --cpus-per-task=$(CPUS) --mem=$(MEM) --time=$(TIME) --export=ALL,ENV_SCRIPT=$(ENV_SCRIPT),SAFE_MODELS="$(SAFE_MODELS)" $(SLURM_DIR)/run_safe_prepare.slurm

.PHONY: submit-method
submit-method: check-env
	@test -n "$(METHOD)" || (echo "METHOD is required" && exit 1)
	@test -n "$(DATASET)" || (echo "DATASET is required" && exit 1)
	sbatch $(if $(ACCOUNT),--account=$(ACCOUNT),) --partition=$(PARTITION) --gres=$(GRES) --cpus-per-task=$(CPUS) --mem=$(MEM) --time=$(TIME) --export=ALL,ENV_SCRIPT=$(ENV_SCRIPT),METHOD=$(METHOD),DATASET=$(DATASET),SAFE_MODELS="$(SAFE_MODELS)" $(SLURM_DIR)/run_safe_method.slurm

.PHONY: submit-exp
submit-exp: check-env
	@test -n "$(METHOD)" || (echo "METHOD is required" && exit 1)
	@test -n "$(DATASET)" || (echo "DATASET is required" && exit 1)
	sbatch $(if $(ACCOUNT),--account=$(ACCOUNT),) --partition=$(PARTITION) --gres=$(GRES) --cpus-per-task=$(CPUS) --mem=$(MEM) --time=$(TIME) --export=ALL,ENV_SCRIPT=$(ENV_SCRIPT),METHOD=$(METHOD),DATASET=$(DATASET),EXP_STAGE=$(EXP_STAGE),PAIR_SCOPE=$(PAIR_SCOPE),CONCURRENCY_PER_GPU=$(CONCURRENCY_PER_GPU),RESUME=$(RESUME),DRY_RUN=$(DRY_RUN),SAFE_MODELS="$(SAFE_MODELS)" $(SLURM_DIR)/run_safe_exp.slurm

.PHONY: submit-sweep
submit-sweep: check-env
	sbatch $(if $(ACCOUNT),--account=$(ACCOUNT),) --partition=$(PARTITION) --gres=$(GRES) --cpus-per-task=$(CPUS) --mem=$(MEM) --time=$(TIME) --export=ALL,ENV_SCRIPT=$(ENV_SCRIPT),EXP_STAGE=$(EXP_STAGE),PAIR_SCOPE=$(PAIR_SCOPE),CONCURRENCY_PER_GPU=$(CONCURRENCY_PER_GPU),RESUME=$(RESUME),DRY_RUN=$(DRY_RUN),METHOD=$(METHOD),DATASETS="$(DATASETS)",SAFE_MODELS="$(SAFE_MODELS)" $(SLURM_DIR)/run_safe_sweep.slurm
